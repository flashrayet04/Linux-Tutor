# ─────────────────────────────────────────────────────────────────────────────
# Linux Tutor — Environment Variables Template
#
# HOW TO USE:
#   1. Copy this file:   cp .env.example .env
#   2. Fill in the values below with your own secrets.
#   3. NEVER commit the .env file to Git — it is listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# A long random string used to sign session cookies.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-secret

# SQLite database file location.
# The path is relative to the backend/ folder.
DATABASE_URL=sqlite:///database.db

# Flask environment: "development" shows debug info, "production" hides it.
FLASK_ENV=development

# ─── CORS ────────────────────────────────────────────────────────────────────
# The URL of the frontend that is allowed to call this API.
# For local dev this is usually the file you open in a browser, or a dev server.
FRONTEND_ORIGIN=http://localhost:5500

# ─── Rate Limiting ───────────────────────────────────────────────────────────
# How many login/register attempts per minute per IP address are allowed.
LOGIN_RATE_LIMIT=5 per minute
REGISTER_RATE_LIMIT=3 per minute
